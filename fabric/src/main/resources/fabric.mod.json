{
  "schemaVersion": 1,
  "id": "foundation",
  "version": "${version}",
  "name": "[Let's Do] Foundation",
  "description": "The shared core library of the Let's Do mods: HUD panels, tooltips, seats, storage, food, armor, wood and more. Bundled with every Let's Do mod, no manual install needed.",
  "authors": [
    "satisfy"
  ],
  "contact": {
    "homepage": "https://www.lets-do.ch",
    "sources": "https://github.com/Let-s-Do-Collection/Foundation",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.foundation.fabric.FoundationFabric"
    ],
    "client": [
      "net.satisfy.foundation.fabric.client.FoundationClientFabric"
    ]
  },
  "mixins": [
    "foundation-fabric.mixins.json",
    "foundation-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": ">=1.21.1 <1.22",
    "architectury": ">=13.0.8"
  }
}
