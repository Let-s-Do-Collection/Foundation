{
  "schemaVersion": 1,
  "id": "foundation",
  "version": "${version}",
  "name": "[Let's Do] Foundation",
  "description": "The shared heart of all Let's Do mods. Look at a block and see what to do next, sit on chairs and sofas, fill shelves that show their items, enjoy food with effects, fireflies around lanterns at night and the Completionist Banner. Keeps every Let's Do mod looking and playing the same.",
  "authors": [
    "satisfy"
  ],
  "contact": {
    "homepage": "https://www.lets-do.ch",
    "sources": "https://github.com/Let-s-Do-Collection/Foundation",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.foundation.fabric.FoundationFabric"
    ],
    "client": [
      "net.satisfy.foundation.fabric.client.FoundationClientFabric"
    ],
    "modmenu": [
      "net.satisfy.foundation.fabric.config.ModMenu"
    ]
  },
  "mixins": [
    "foundation-fabric.mixins.json",
    "foundation-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "architectury": ">=13.0.8",
    "cloth-config": "*"
  }
}
